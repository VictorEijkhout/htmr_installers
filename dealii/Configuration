################################################################
####
#### Makefile for Dealii installation
####
#### Kokkos problem:
#### https://github.com/dealii/dealii/issues/18928
####
################################################################

PACKAGE = dealii
ABOUT = Finite Element Library
URL = https://github.com/dealii/dealii
PACKAGEVERSION = 9.9.9
DOWNLOADURL = https://github.com/dealii/dealii/releases/download/v${PACKAGEVERSION}/dealii-${PACKAGEVERSION}.tar.gz
GITREPO = https://github.com/dealii/dealii.git
MODE = mpi

BUILDSYSTEM = cmake

MODULES = boost cmake
#DEPENDSONCURRENT = boost

HAS_PETSC = ON
HAS_PETSC==ON MODULES += petsc

HAS_PHDF5 = OFF
HAS_PHDF5==ON MODULES += phdf5/1.14

HAS_SUNDIALS = OFF
HAS_SUNDIALS==ON MODULES += sundials

# optional packages
HAS_P4EST = ON
HAS_P4EST==ON MODULES += p4est
HAS_P4EST==ON DEPENDSON = p4est

HAS_TRILINOS = ON
HAS_TRILINOS==ON MODULES += trilinos

CONFIGURATION = default
COMPLEX = OFF

# c++23 makes trilinos barf
CPP23FLAGS = -D CMAKE_CXX_STANDARD=20
HAS_TRILINOS==OFF CPP23FLAGS = -D CMAKE_CXX_STANDARD=23 -D DEAL_II_HAVE_CXX23_FEATURES=ON

CMAKEFLAGS = \
    -D DEAL_II_WITH_MPI=ON \
    -D CMAKE_CXX_FLAGS="-fopenmp" \
    ${CPP23FLAGS} \
    -D DEAL_II_WITH_LAPACK=ON \
    -D DEAL_II_COMPONENT_EXAMPLES=OFF \
    -D DEAL_II_WITH_TASKFLOW=OFF \
    -D DEAL_II_WITH_TBB=ON
HAS_PHDF5==ON CMAKEFLAGS += \
    -D DEAL_II_WITH_HDF5=${HAS_PHDF5} \
    -D HDF5_DIR=${TACC_PHDF5_DIR}
HAS_P4EST==ON CMAKEFLAGS += \
    -D DEAL_II_WITH_P4EST=${HAS_P4EST}    -D P4EST_DIR=${TACC_P4EST_DIR}
HAS_PETSC==ON CMAKEFLAGS += \
    -D DEAL_II_WITH_PETSC=${HAS_PETSC}    -D PETSC_DIR=${PETSC_DIR} -D PETSC_ARCH=${PETSC_ARCH}
HAS_SUNDIALS==ON CMAKEFLAGS += \
    -D DEAL_II_WITH_SUNDIALS=${HAS_SUNDIALS} -D SUNDIALS_DIR=${TACC_SUNDIALS_DIR}
HAS_TRILINOS==ON CMAKEFLAGS += \
    -D DEAL_II_WITH_TRILINOS=${HAS_TRILINOS} -D TRILINOS_DIR=${TACC_TRILINOS_DIR}

PREFIXPATHSET = 1
#CPTOINSTALLDIR = examples
CMAKEBUILDTYPE = DebugRelease
INSTALLEXT = real
INSTALLVARIANT = real
# dependencies
DEPENDSON = sundials
HAS_TRILINOS==ON DEPENDSON = trilinos
HAS_PHDF5==ON DEPENDSONCURRENT = phdf5

